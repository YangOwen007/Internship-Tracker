# Required: local example only. Use a managed TLS-protected URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship_tracker?schema=public"
# Required: replace with at least 32 random bytes; never deploy this placeholder.
NEXTAUTH_SECRET="replace-this-with-a-long-random-string"
# Required: use the canonical HTTPS origin in a public deployment.
NEXTAUTH_URL="http://localhost:3000"
# Public signup defaults to enabled locally and disabled in production. Only
# enable it in production after adding a platform-level distributed rate limit.
# PUBLIC_SIGNUP_ENABLED="false"
# Required in production; optional locally (browser preview link without email).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="Internship Tracker <noreply@your-domain.example>"
# Optional: set this if you want a stable local demo password when seeding.
# SEED_DEMO_PASSWORD="choose-a-local-demo-password"
